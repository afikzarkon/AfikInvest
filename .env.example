# --- שרת (Render / Railway / VPS) — לא רץ ב-Vercel ---
JWT_SECRET=שנה-אותי-למחרוזת-אקראית-ארוכה
NODE_ENV=production

# פרונט ב-Vercel + API בכתובת אחרת — חובה לעוגיות התחברות:
# CROSS_SITE_COOKIES=1

# מסד חינמי בענן (Supabase / Neon): הדבק את Connection String (URI). אם מוגדר — לא נדרש דיסק ב-Render.
# משתמשי Supabase: אם החיבור ל-host db.xxx.supabase.co נכשל מ-Render (IPv4), השתמש ב-URI של Session Pooler מהדשבורד.
# אם בסיסמת ה-DB יש תווים מיוחדים (@ # וכו') — חובה להקיד אותם ב-URI או החלפת סיסמה.
# DATABASE_URL=postgresql://...
# אם יש בעיית SSL מקומית בלבד: DATABASE_SSL=0

# SQLite מקומי רק כשאין DATABASE_PATH:
# DATABASE_PATH=

# --- בניית React ב-Vercel (Settings → Environment Variables → Production) ---
# כתובת השרת בלי סלאש בסוף, לדוגמה https://xxx.onrender.com
# REACT_APP_API_URL=

# --- Background jobs (Smart Alerts, event calendar) ---
# Shared secret for POST /api/internal/jobs/:name. Set the same value as the
# CRON_SECRET GitHub Actions secret (see .github/workflows/scheduled-jobs.yml).
# CRON_SECRET=
# JOBS_POLL=0 turns off the in-process job poller (the scheduler still works).
# JOBS_POLL=1

# --- Valuation (P/E, P/S, P/FCF history and DCF inputs) ---
# Optional: Financial Modeling Prep key for longer, documented statement
# history. Without it the statements come from Yahoo (about 4-5 fiscal years).
# FMP_API_KEY=

# --- Security / CORS ---
# Public address of the web app (no trailing slash). Used for links in emails
# (password reset) and allowed by CORS. Required in production.
# APP_URL=https://your-app.vercel.app
# Extra front-end origins allowed to call the API, comma-separated.
# CORS_ORIGINS=https://preview.your-app.vercel.app

# --- Email (Gmail) ---
# EMAIL_USER is the Gmail address mail is sent from.
# EMAIL_USER=you@gmail.com
#
# Option A - Gmail API over HTTPS (required on Render's free plan, which
# blocks SMTP ports). OAuth client from Google Cloud with the Gmail API
# enabled, and a refresh token for the gmail.send scope. Takes precedence
# over EMAIL_PASS when set.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
#
# Option B - SMTP with a Gmail App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), not the account password.
# EMAIL_PASS=abcd efgh ijkl mnop
#
# With neither, emails are printed to the console in development and
# skipped in production.

# --- Two-factor authentication ---
# Key that encrypts stored TOTP secrets. Defaults to one derived from
# JWT_SECRET. Changing it (or JWT_SECRET, if this is unset) makes every user
# set 2FA up again.
# TOTP_ENCRYPTION_KEY=
